# Run the Vite dev server with HMR. Single stage - node ships, on purpose.
FROM node:22-alpine

WORKDIR /app

COPY package*.json .
RUN npm ci

COPY . .

# Vite's default port
EXPOSE 5173

# --host binds 0.0.0.0; the default localhost is unreachable from outside
CMD ["npm", "run", "dev", "--", "--host"]
